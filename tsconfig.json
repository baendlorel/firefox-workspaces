{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "vite/client", "firefox-webext-browser"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "declaration": false,
    "esModuleInterop": true,
    "strict": true,
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@web/*": ["./src/web/*"],
      "@assets/*": ["./src/web/assets/*"],
      "@comp/*": ["./src/web/components/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "pages/**/*.ts"]
}
